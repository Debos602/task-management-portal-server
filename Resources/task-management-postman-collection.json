{
  "info": {
    "name": "Task Management API",
    "description": "Postman collection for task management and dashboard APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "List Tasks",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/tasks?search=dashboard&status=In%20Progress&priority=High&page=1&limit=10&sortBy=createdAt&sortOrder=desc",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "tasks"],
          "query": [
            { "key": "search", "value": "dashboard" },
            { "key": "status", "value": "In Progress" },
            { "key": "priority", "value": "High" },
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" },
            { "key": "sortBy", "value": "createdAt" },
            { "key": "sortOrder", "value": "desc" }
          ]
        }
      }
    },
    {
      "name": "Dashboard State",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/tasks/dashboard",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "tasks", "dashboard"]
        },
        "description": "Returns task totals, status counts, priority counts, and recent tasks."
      }
    },
    {
      "name": "Get Task",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/tasks/:id",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "tasks", ":id"],
          "variable": [{ "key": "id", "value": "" }]
        }
      }
    },
    {
      "name": "Create Task",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Prepare dashboard report\",\n  \"description\": \"Review task progress\",\n  \"priority\": \"High\",\n  \"status\": \"Pending\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/tasks",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "tasks"]
        }
      }
    },
    {
      "name": "Update Task Status and Priority",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"In Progress\",\n  \"priority\": \"High\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/tasks/:id/status-priority",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "tasks", ":id", "status-priority"],
          "variable": [{ "key": "id", "value": "" }]
        },
        "description": "Updates status, priority, or both."
      }
    },
    {
      "name": "Move Task (Drag and Drop)",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"targetStatus\": \"In Progress\",\n  \"targetPosition\": 0\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/tasks/:id/move",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "tasks", ":id", "move"],
          "variable": [{ "key": "id", "value": "" }]
        },
        "description": "Moves a task to a status column and zero-based position."
      }
    },
    {
      "name": "Update Task",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Updated dashboard report\",\n  \"description\": \"Updated task description\",\n  \"priority\": \"Medium\",\n  \"status\": \"Completed\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/tasks/:id",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "tasks", ":id"],
          "variable": [{ "key": "id", "value": "" }]
        }
      }
    },
    {
      "name": "Delete Task",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/tasks/:id",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "tasks", ":id"],
          "variable": [{ "key": "id", "value": "" }]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    }
  ]
}
